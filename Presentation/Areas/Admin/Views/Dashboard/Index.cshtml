@model Application.Modules.AdminModule.Queries.DashboardStats.AdminDashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-body">
    <div class="row">
        <!-- Students -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-blue update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalStudents</h4>
                            <h6 class="text-white m-b-0">Total Students</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-users text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Teachers -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-green update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalTeachers</h4>
                            <h6 class="text-white m-b-0">Total Teachers</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-user-check text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Faculties -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-pink update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalFaculties</h4>
                            <h6 class="text-white m-b-0">Total Faculties</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-home text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Departments -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-lite-green update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalDepartments</h4>
                            <h6 class="text-white m-b-0">Total Departments</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-briefcase text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Groups -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-yellow update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalGroups</h4>
                            <h6 class="text-white m-b-0">Total Groups</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-layers text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Subjects -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-blue update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalSubjects</h4>
                            <h6 class="text-white m-b-0">Total Subjects</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-book text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lessons -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-c-pink update-card">
                <div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-8">
                            <h4 class="text-white">@Model.TotalLessons</h4>
                            <h6 class="text-white m-b-0">Total Lessons</h6>
                        </div>
                        <div class="col-4 text-right">
                            <i class="feather icon-calendar text-white f-34"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>